# Copia este archivo a .env solo si necesitas cambiar puertos o UID. .env NUNCA se sube a GitHub.
# El laboratorio no usa secretos: las claves SSH se generan en `make lab-up` dentro de un volumen
# Docker y se destruyen con `make lab-down`.

# Puertos publicados SOLO en 127.0.0.1 del equipo anfitrión
LAB_SSH_PORT=2222
LAB_WEB_SSH_PORT=2223
LAB_DB_SSH_PORT=2224
LAB_HTTP_PORT=18080
LAB_HTTPS_PORT=18443
LAB_DB_PORT=15432

# UID/GID con el que corre el contenedor controlador (en Linux, tu `id -u` / `id -g`)
LAB_UID=
LAB_GID=
