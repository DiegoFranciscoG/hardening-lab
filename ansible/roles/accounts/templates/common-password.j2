# {{ ansible_managed }}
# hardening-lab HL-PAM-002, HL-PAM-003 y HL-PAM-004: calidad, historial y yescrypt con use_authtok.
password	requisite			pam_pwquality.so retry=3
password	requisite			pam_pwhistory.so remember={{ accounts_pwhistory_remember }} enforce_for_root try_first_pass use_authtok
password	[success=1 default=ignore]	pam_unix.so obscure use_authtok try_first_pass yescrypt
password	requisite			pam_deny.so
password	required			pam_permit.so
