{
  "$defs": {
    "ControlResult": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "title": "Control Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "exception_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exception Id"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "sources": {
          "description": "tool:check_id que aportaron al estado",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "required": [
        "host",
        "control_id",
        "status",
        "severity"
      ],
      "title": "ControlResult",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/Method"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "method"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Method": {
      "enum": [
        "examine",
        "test"
      ],
      "title": "Method",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Status": {
      "enum": [
        "pass",
        "fail",
        "exception",
        "notapplicable",
        "notchecked",
        "info",
        "error"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "$id": "https://github.com/DiegoFranciscoG/hardening-lab/schemas/v1/controls-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ControlResult"
      },
      "title": "Results",
      "type": "array"
    },
    "run_id": {
      "pattern": "^\\d{8}T\\d{6}Z-(baseline|hardened|drift|scheduled)$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "generated_at",
    "results"
  ],
  "title": "ControlsReport",
  "type": "object"
}
