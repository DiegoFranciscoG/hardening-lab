{
  "$defs": {
    "Phase": {
      "enum": [
        "baseline",
        "hardened",
        "drift",
        "scheduled"
      ],
      "title": "Phase",
      "type": "string"
    }
  },
  "$id": "https://github.com/DiegoFranciscoG/hardening-lab/schemas/v1/history-row.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compliance_with_exceptions": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Compliance With Exceptions"
    },
    "critical_fail": {
      "minimum": 0,
      "title": "Critical Fail",
      "type": "integer"
    },
    "error": {
      "minimum": 0,
      "title": "Error",
      "type": "integer"
    },
    "exception": {
      "minimum": 0,
      "title": "Exception",
      "type": "integer"
    },
    "fail": {
      "minimum": 0,
      "title": "Fail",
      "type": "integer"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "git_sha": {
      "title": "Git Sha",
      "type": "string"
    },
    "high_fail": {
      "minimum": 0,
      "title": "High Fail",
      "type": "integer"
    },
    "host": {
      "title": "Host",
      "type": "string"
    },
    "info": {
      "minimum": 0,
      "title": "Info",
      "type": "integer"
    },
    "low_fail": {
      "minimum": 0,
      "title": "Low Fail",
      "type": "integer"
    },
    "medium_fail": {
      "minimum": 0,
      "title": "Medium Fail",
      "type": "integer"
    },
    "native_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Native Score"
    },
    "notapplicable": {
      "minimum": 0,
      "title": "Notapplicable",
      "type": "integer"
    },
    "notchecked": {
      "minimum": 0,
      "title": "Notchecked",
      "type": "integer"
    },
    "pass": {
      "minimum": 0,
      "title": "Pass",
      "type": "integer"
    },
    "phase": {
      "$ref": "#/$defs/Phase"
    },
    "role": {
      "title": "Role",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "strict_compliance": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Strict Compliance"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "finished_at",
    "phase",
    "git_sha",
    "host",
    "role",
    "tool",
    "tool_version",
    "native_score",
    "pass",
    "fail",
    "exception",
    "notapplicable",
    "notchecked",
    "info",
    "error",
    "critical_fail",
    "high_fail",
    "medium_fail",
    "low_fail",
    "strict_compliance",
    "compliance_with_exceptions"
  ],
  "title": "HistoryRow",
  "type": "object"
}
