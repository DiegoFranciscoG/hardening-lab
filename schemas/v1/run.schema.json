{
  "$defs": {
    "Benchmark": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "via": {
          "title": "Via",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "via"
      ],
      "title": "Benchmark",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "baseline",
        "hardened",
        "drift",
        "scheduled"
      ],
      "title": "Phase",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ToolInfo": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolInfo",
      "type": "object"
    }
  },
  "$id": "https://github.com/DiegoFranciscoG/hardening-lab/schemas/v1/run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmarks": {
      "items": {
        "$ref": "#/$defs/Benchmark"
      },
      "title": "Benchmarks",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "git_dirty": {
      "title": "Git Dirty",
      "type": "boolean"
    },
    "git_sha": {
      "title": "Git Sha",
      "type": "string"
    },
    "hosts": {
      "items": {
        "type": "string"
      },
      "title": "Hosts",
      "type": "array"
    },
    "inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inventory Sha256",
      "type": "string"
    },
    "lab_state": {
      "enum": [
        "baseline",
        "hardened"
      ],
      "title": "Lab State",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/Phase"
    },
    "run_id": {
      "pattern": "^\\d{8}T\\d{6}Z-(baseline|hardened|drift|scheduled)$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolInfo"
      },
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "phase",
    "lab_state",
    "started_at",
    "finished_at",
    "git_sha",
    "git_dirty",
    "inventory_sha256",
    "hosts",
    "tools",
    "benchmarks",
    "status"
  ],
  "title": "Run",
  "type": "object"
}
